# PostgreSQL connection used by the backend.
# Copy this file to .env and fill in the real value.
DATABASE_URL=postgresql://todo:todo@127.0.0.1:5432/todo_show

# Optional: Python package index used while building the backend image.
# PIP_INDEX_URL=https://pypi.org/simple

# Optional: host ports exposed by docker compose.
FRONTEND_PORT=3080
BACKEND_PORT=8010
