TRACEFORGE_HOST=0.0.0.0
TRACEFORGE_PORT=19090
TRACEFORGE_ENV=development
TRACEFORGE_DATABASE_URL=postgresql://traceforge:traceforge_dev_password@traceforge-postgres:5432/traceforge
TRACEFORGE_API_URL=http://127.0.0.1:19090
TRACEFORGE_DB_PATH=.traceforge/traceforge.sqlite3

# DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-me

# 独立 TraceForge Zulip，不要指向本机正在使用的现有 Zulip。
TRACEFORGE_ZULIP_URL=https://127.0.0.1:18443
TRACEFORGE_ZULIP_EMAIL=Jarvis-bot@traceforge.local
TRACEFORGE_ZULIP_API_KEY=replace-me
TRACEFORGE_ZULIP_BOT_NAME=Jarvis
TRACEFORGE_ZULIP_VERIFY_SSL=false
TRACEFORGE_ZULIP_POLL_INTERVAL_SECONDS=1.0
TRACEFORGE_ZULIP_PROGRESS_ENABLED=true
TRACEFORGE_ZULIP_REACTIONS_ENABLED=true

# AgentRuntime limits one request, not the lifetime of a Zulip conversation.
TRACEFORGE_AGENT_MAX_MODEL_TURNS=8
TRACEFORGE_AGENT_MAX_TOOL_CALLS=12

# 兼容旧变量名；新代码优先读取 TRACEFORGE_ZULIP_*，避免被其他项目污染。
ZULIP_URL=https://127.0.0.1:18443
ZULIP_EMAIL=Jarvis-bot@traceforge.local
ZULIP_API_KEY=replace-me
ZULIP_BOT_NAME=Jarvis
ZULIP_VERIFY_SSL=false
ZULIP_POLL_INTERVAL_SECONDS=1.0
