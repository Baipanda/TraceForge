TRACEFORGE_HOST=0.0.0.0
TRACEFORGE_PORT=19090
TRACEFORGE_ENV=development
TRACEFORGE_DATABASE_URL=postgresql://traceforge:traceforge_dev_password@traceforge-postgres:5432/traceforge
TRACEFORGE_API_URL=http://127.0.0.1:19090
TRACEFORGE_DB_PATH=.traceforge/traceforge.sqlite3

# DeepSeek OpenAI-compatible API.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-me

# 独立 TraceForge Zulip，不要指向本机正在使用的现有 Zulip。
TRACEFORGE_ZULIP_URL=https://127.0.0.1:18443
TRACEFORGE_ZULIP_EMAIL=Jarvis-bot@traceforge.local
TRACEFORGE_ZULIP_API_KEY=replace-me
TRACEFORGE_ZULIP_BOT_NAME=Jarvis
TRACEFORGE_ZULIP_VERIFY_SSL=false
TRACEFORGE_ZULIP_POLL_INTERVAL_SECONDS=1.0
TRACEFORGE_ZULIP_PROGRESS_ENABLED=true
TRACEFORGE_ZULIP_REACTIONS_ENABLED=true

# Gitea → RepoAudit shout path (webhook notify; no Zulip bridge required for outbound).
TRACEFORGE_GITEA_WEBHOOK_SECRET=replace-me
TRACEFORGE_REPOAUDIT_ZULIP_EMAIL=RepoAudit-bot@traceforge.local
TRACEFORGE_REPOAUDIT_ZULIP_API_KEY=replace-me
TRACEFORGE_REPOAUDIT_NOTIFY_STREAM=general
TRACEFORGE_REPOAUDIT_NOTIFY_TOPIC=gitea

# Gitea API（gitea-audit 拉文件做语法检查）
TRACEFORGE_GITEA_URL=http://127.0.0.1:13000
TRACEFORGE_GITEA_TOKEN=replace-me
TRACEFORGE_AGENTS_CONFIG=agents.yaml

# AgentRuntime limits one request, not the lifetime of a Zulip conversation.
TRACEFORGE_AGENT_MAX_MODEL_TURNS=8
TRACEFORGE_AGENT_MAX_TOOL_CALLS=12

# Memory search: Markdown + FTS + local embedding (OpenClaw-style, no API key by default).
TRACEFORGE_MEMORY_SEARCH_MODE=hybrid
TRACEFORGE_MEMORY_EMBEDDING_ENABLED=true
TRACEFORGE_MEMORY_EMBEDDING_PROVIDER=local
TRACEFORGE_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
TRACEFORGE_MEMORY_EMBEDDING_CACHE_DIR=.traceforge/models/embeddings
TRACEFORGE_MEMORY_HYBRID_FTS_WEIGHT=0.5
# 国内下载 embedding 模型（download_embedding.sh 默认已走 hf-mirror）：
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1
# Optional remote fallback: TRACEFORGE_MEMORY_EMBEDDING_FALLBACK=http + OPENAI_API_KEY

# Tavily MCP (Jarvis web.search)
TAVILY_API_KEY=replace-me
TRACEFORGE_MCP_TAVILY_COMMAND=npx
TRACEFORGE_MCP_TAVILY_ARGS=-y,tavily-mcp@latest

# 兼容旧变量名；新代码优先读取 TRACEFORGE_ZULIP_*，避免被其他项目污染。
ZULIP_URL=https://127.0.0.1:18443
ZULIP_EMAIL=Jarvis-bot@traceforge.local
ZULIP_API_KEY=replace-me
ZULIP_BOT_NAME=Jarvis
ZULIP_VERIFY_SSL=false
ZULIP_POLL_INTERVAL_SECONDS=1.0
